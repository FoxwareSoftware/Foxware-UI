        function Tab:AddSlider(SldConfig) 
            local Sld = { Min = SldConfig.Min or 0, Max = SldConfig.Max or 100, Val = SldConfig.Default or 50 } 
            local SldName = SldConfig.Name or "Slider" 
            local Frame = Instance.new("Frame", ContentFrame) 
            Frame.Size = UDim2New(1, -5, 0, 55) 
            Frame.BackgroundColor3 = SelectedTheme.Element 
            Frame.ZIndex = 5 
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6) 
            
            local Label = Instance.new("TextLabel", Frame) 
            Label.Size = UDim2New(1, -20, 0, 25) 
            Label.Position = UDim2New(0, 10, 0, 4) 
            Label.Text = SldName .. " : " .. tostring(Sld.Val) 
            Label.TextColor3 = FromRGB(240, 240, 240) 
            Label.BackgroundTransparency = 1 
            Label.Font = Midnight.Font 
            Label.TextSize = 15 
            Label.TextXAlignment = Enum.TextXAlignment.Left 
            Label.ZIndex = 6 
            
            local Track = Instance.new("TextButton", Frame) 
            Track.Size = UDim2New(1, -20, 0, 8) 
            Track.Position = UDim2New(0, 10, 0, 34) 
            Track.BackgroundColor3 = FromRGB(60, 60, 60) 
            Track.Text = "" 
            Track.ZIndex = 6 
            Instance.new("UICorner", Track) 
            
            local Bar = Instance.new("Frame", Track) 
            Bar.Size = UDim2New((Sld.Val - Sld.Min)/(Sld.Max - Sld.Min), 0, 1, 0) 
            Bar.BackgroundColor3 = SelectedTheme.Accent 
            Bar.ZIndex = 7 
            Instance.new("UICorner", Bar) 
            
            local isDragging = false 
            local function UpdateSliderValue(input) 
                local ratio = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1) 
                local newValue = math.floor(Sld.Min + (Sld.Max - Sld.Min) * ratio) 
                Sld.Val = newValue 
                Bar.Size = UDim2New(ratio, 0, 1, 0) 
                Label.Text = SldName .. " : " .. tostring(Sld.Val) 
                if SldConfig.Callback then SldConfig.Callback(Sld.Val) end 
            end 
            
            Track.InputBegan:Connect(function(input) 
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
                    isDragging = true 
                    UpdateSliderValue(input) 
                end 
            end) 
            UserInputService.InputChanged:Connect(function(input) 
                if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then 
                    UpdateSliderValue(input) 
                end 
            end) 
            UserInputService.InputEnded:Connect(function(input) 
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
                    isDragging = false 
                end 
            end) 
            CheckElements() 
        end 
        
        function Tab:AddDropdown(DropConfig) 
            local Drop = { Options = DropConfig.Options or {}, Current = DropConfig.Default or "", Open = false } 
            local DropName = DropConfig.Name or "Dropdown" 
            local Frame = Instance.new("Frame", ContentFrame) 
            Frame.Size = UDim2New(1, -5, 0, 40) 
            Frame.BackgroundColor3 = SelectedTheme.Element 
            Frame.ClipsDescendants = true 
            Frame.ZIndex = 5 
            Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6) 
            
            local Btn = Instance.new("TextButton", Frame) 
            Btn.Size = UDim2New(1, 0, 0, 40) 
            Btn.Text = " " .. DropName .. " [" .. Drop.Current .. "]" 
            Btn.TextColor3 = FromRGB(240, 240, 240) 
            Btn.BackgroundColor3 = SelectedTheme.Element 
            Btn.TextXAlignment = Enum.TextXAlignment.Left 
            Btn.Font = Midnight.Font 
            Btn.TextSize = 16 
            Btn.ZIndex = 6 
            
            local ItemList = Instance.new("Frame", Frame) 
            ItemList.Size = UDim2New(1, 0, 1, -40) 
            ItemList.Position = UDim2New(0, 0, 0, 40) 
            ItemList.BackgroundTransparency = 1 
            ItemList.ZIndex = 6 
            local ItemLayout = Instance.new("UIListLayout", ItemList) 
            
            Btn.MouseButton1Click:Connect(function() 
                Drop.Open = not Drop.Open 
                local targetHeight = Drop.Open and (40 + (#Drop.Options * 28)) or 40 
                TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2New(1, -5, 0, targetHeight)}):Play() 
            end) 
            
            for _, opt in pairs(Drop.Options) do 
                local OptBtn = Instance.new("TextButton", ItemList) 
                OptBtn.Size = UDim2New(1, 0, 0, 28) 
                OptBtn.BackgroundColor3 = SelectedTheme.Element 
                OptBtn.Text = " " .. opt 
                OptBtn.TextColor3 = FromRGB(170, 170, 170) 
                OptBtn.Font = Midnight.Font 
                OptBtn.TextSize = 14 
                OptBtn.TextXAlignment = Enum.TextXAlignment.Left 
                OptBtn.ZIndex = 7 
                
                OptBtn.MouseButton1Click:Connect(function() 
                    Drop.Current = opt 
                    Btn.Text = " " .. DropName .. " [" .. Drop.Current .. "]" 
                    Drop.Open = false 
                    TweenService:Create(Frame, TweenInfo.new(0.2), {Size = UDim2New(1, -5, 0, 40)}):Play() 
                    if DropConfig.Callback then DropConfig.Callback(opt) end 
                end) 
            end 
            CheckElements() 
        end 
        
