                TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = SelectedTheme.Accent}):Play() 
                task.wait(0.1) 
                TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = SelectedTheme.Element}):Play() 
                if BtnConfig.Callback then BtnConfig.Callback() end 
            end) 
            CheckElements() 
        end 
        
        function Tab:AddToggle(TglConfig) 
            local Tgl = { State = TglConfig.Default or false } 
            local Btn = Instance.new("TextButton", ContentFrame) 
            Btn.Size = UDim2New(1, -5, 0, 40) 
