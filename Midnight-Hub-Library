    function Window:AddTab(TabName) 
        local Tab = {} 
        local ContentFrame = Instance.new("ScrollingFrame", ContainerHolder) 
        ContentFrame.Size = UDim2New(1, 0, 1, 0) 
        ContentFrame.BackgroundTransparency = 1 
        ContentFrame.CanvasSize = UDim2New(0, 0, 0, 0) 
        ContentFrame.ScrollBarThickness = 4 
        ContentFrame.Visible = false 
        ContentFrame.ZIndex = 4 
        
        local ContentLayout = Instance.new("UIListLayout", ContentFrame) 
        ContentLayout.Padding = UDim.new(0, 8) 
        ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder 
        ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() 
            ContentFrame.CanvasSize = UDim2New(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 15) 
        end) 
        
        local EmptyLabel = Instance.new("TextLabel", ContentFrame) 
        EmptyLabel.Name = "EmptyTabLabel" 
        EmptyLabel.Size = UDim2New(1, 0, 0, 25) 
        EmptyLabel.BackgroundTransparency = 1 
        EmptyLabel.Text = "This tab is Empty" 
        EmptyLabel.TextColor3 = SelectedTheme.Text 
        EmptyLabel.TextTransparency = 0.4 
        EmptyLabel.Font = Midnight.Font 
        EmptyLabel.TextSize = 16 
        EmptyLabel.TextXAlignment = Enum.TextXAlignment.Center 
        EmptyLabel.Visible = false 
        EmptyLabel.ZIndex = 5 
        
        local function CheckElements() 
            local elementCount = 0 
            for _, child in pairs(ContentFrame:GetChildren()) do 
                if child:IsA("UIListLayout") or child.Name == "EmptyTabLabel" then continue end 
                if child:IsA("TextButton") or child:IsA("Frame") or child:IsA("TextLabel") then 
                    elementCount = elementCount + 1 
                end 
            end 
            -- Perbaikan logika visibility CheckElements
            EmptyLabel.Visible = (elementCount == 0) 
        end 
        
        local TabBtn = Instance.new("TextButton", SidebarTabs) 
        TabBtn.Size = UDim2New(0, 125, 0, 36) 
        TabBtn.BackgroundColor3 = SelectedTheme.Element 
        TabBtn.Text = TabName 
        TabBtn.TextColor3 = FromRGB(180, 180, 180) 
        TabBtn.Font = Midnight.Font 
        TabBtn.TextSize = 15 
        TabBtn.ZIndex = 5 
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6) 
        TabBtn.LayoutOrder = #Window.Tabs + 1 
        
        TabBtn.MouseButton1Click:Connect(function() 
            for _, frame in pairs(ContainerHolder:GetChildren()) do 
                if frame:IsA("ScrollingFrame") then frame.Visible = false end 
            end 
            for _, btn in pairs(SidebarTabs:GetChildren()) do 
                if btn:IsA("TextButton") then btn.TextColor3 = FromRGB(180, 180, 180) end 
            end 
            ContentFrame.Visible = true 
            TabBtn.TextColor3 = SelectedTheme.Accent 
            
            -- Memastikan fungsi check ter-update saat tab diklik
            CheckElements()
        end) 
        
        if #Window.Tabs == 0 then 
            ContentFrame.Visible = true 
            TabBtn.TextColor3 = SelectedTheme.Accent 
        end 
        
        Tab.UpdateCheck = CheckElements 
        table.insert(Window.Tabs, Tab) -- Dimasukkan lebih awal agar terbaca sistem window
        
